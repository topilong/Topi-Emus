{
    "version": "2026.10.21.1520",
    "description": "Flycast - Sega Dreamcast, Naomi and Atomiswave emulator (master branch builds)",
    "homepage": "https://github.com/flyinghead/flycast",
    "license": "GPL-2.0-only",
    "url": "https://flycast-builds.s3.fr-par.scw.cloud/win/heads/master-5543a95c4f711395fc000dac80ce6b1dc7e49606/flycast.zip",
    "hash": "25523c476fd563c4f0937eac505faaeb375a7cfad02c9a3fc5f2eb2ccbf8ccbb",
    "pre_install": "if (!(Test-Path \"$persist_dir\\emu.cfg\")) { New-Item -ItemType File \"$dir\\emu.cfg\" | Out-Null }",
    "bin": "flycast.exe",
    "shortcuts": [
        [
            "flycast.exe",
            "Flycast"
        ]
    ],
    "persist": [
        "emu.cfg",
        "data",
        "mappings"
    ],
    "checkver": {
        "script": [
            "$xml = [xml](Invoke-WebRequest 'https://flycast-builds.s3.fr-par.scw.cloud/?prefix=win/heads/master-' -UseBasicParsing).Content",
            "$latest = $xml.ListBucketResult.Contents | Sort-Object { [datetime]$_.LastModified } -Descending | Select-Object -First 1",
            "$hash = ($latest.Key.Trim() -split '/')[2] -replace '^master-', ''",
            "$ver = ([datetime]$latest.LastModified).ToUniversalTime().ToString('yyyy.MM.dd.HHmm')",
            "Write-Output \"$ver $hash\""
        ],
        "regex": "(\\S+) (?<hash>[0-9a-f]{40})"
    },
    "autoupdate": {
        "url": "https://flycast-builds.s3.fr-par.scw.cloud/win/heads/master-$matchHash/flycast.zip"
    }
}
